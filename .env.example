# FRED API Key — free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Anthropic API Key — only needed for LLM narrative generation in reports
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily API Key — optional, enables live macro news in LLM narratives (fetch_news=True)
# Free tier: 1000 searches/month — sign up at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
